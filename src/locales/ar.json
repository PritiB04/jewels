                },
                {
                    "question": "\u0643\u064a\u0641 \u062a\u0636\u0645\u0646 \u0643\u0631\u0627\u0641\u062a\u0631\u0632 \u0627\u0644\u062c\u0648\u062f\u0629 \u0648\u0627\u0644\u0623\u0635\u0627\u0644\u0629\u061f",
                    "answer": "\u062a\u062e\u0636\u0639 \u0643\u0644 \u0642\u0637\u0639\u0629 \u0644\u0631\u0642\u0627\u0628\u0629 \u062c\u0648\u062f\u0629 \u0635\u0627\u0631\u0645\u0629 \u0642\u0628\u0644 \u0627\u0644\u0634\u062d\u0646. \u0646\u0639\u0645\u0644 \u0645\u0639 \u062d\u0631\u0641\u064a\u064a\u0646 \u0645\u0639\u062a\u0645\u062f\u064a\u0646 \u064a\u0636\u0639\u0648\u0646 \u0627\u0644\u0623\u062d\u062c\u0627\u0631 \u064a\u062f\u0648\u064a\u0627\u064b \u0648\u064a\u0634\u0637\u0628\u0648\u0646 \u0643\u0644 \u0639\u0646\u0635\u0631 \u0648\u0641\u0642 \u0645\u0639\u0627\u064a\u064a\u0631\u0646\u0627 \u0627\u0644\u062f\u0642\u064a\u0642\u0629. \u064a\u0639\u0643\u0633 \u0645\u062a\u0648\u0633\u0637 \u062a\u0642\u064a\u064a\u0645\u0646\u0627 4.9/5 \u0645\u0646 \u0623\u0643\u062b\u0631 \u0645\u0646 12,400 \u0639\u0645\u064a\u0644 \u0645\u0648\u062b\u0642 \u0627\u0644\u062a\u0632\u0627\u0645\u0646\u0627 \u0628\u0627\u0644\u062a\u0645\u064a\u0632."
                },
                {
                    "question": "\u0645\u0627 \u0647\u064a \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u0647\u0644 \u062a\u0642\u062f\u0645\u0648\u0646 \u062e\u0635\u0648\u0645\u0627\u062a\u061f",
                    "answer": "\u062a\u062a\u0631\u0627\u0648\u062d \u0642\u0637\u0639\u0646\u0627 \u0628\u064a\u0646 28 \u0648115 \u062f\u0648\u0644\u0627\u0631\u0627\u064b\u060c \u0645\u0639 \u062a\u0633\u0639\u064a\u0631 \u0645\u0639\u0638\u0645 \u0627\u0644\u0623\u0643\u062b\u0631 \u0645\u0628\u064a\u0639\u0627\u064b \u0628\u064a\u0646 30\u201370 \u062f\u0648\u0644\u0627\u0631\u0627\u064b. \u0646\u0642\u062f\u0645 \u0628\u0627\u0646\u062a\u0638\u0627\u0645 \u062a\u062e\u0641\u064a\u0636\u0627\u062a \u0645\u0648\u0633\u0645\u064a\u0629 \u0645\u062b\u0644 \u0645\u062c\u0645\u0648\u0639\u0629 \u062a\u0648\u0647\u062c \u0627\u0644\u0635\u064a\u0641 \u0628\u062e\u0635\u0645 40%. \u0627\u0644\u0634\u062d\u0646 \u0645\u062c\u0627\u0646\u064a \u0644\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0632\u064a\u062f \u0639\u0646 50 \u062f\u0648\u0644\u0627\u0631\u0627\u064b."
                },
                {
                    "question": "\u0645\u0627 \u0627\u0644\u0630\u064a \u064a\u0645\u064a\u0632 \u0643\u0631\u0627\u0641\u062a\u0631\u0632 \u0639\u0646 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0623\u062e\u0631\u0649\u061f",
                    "answer": "\u062a\u062c\u0645\u0639 \u0643\u0631\u0627\u0641\u062a\u0631\u0632 \u062b\u0644\u0627\u062b\u0629 \u0645\u0645\u064a\u0632\u0627\u062a \u0631\u0626\u064a\u0633\u064a\u0629: \u062a\u0635\u0645\u064a\u0645 \u0628\u0633\u064a\u0637 \u0648\u062e\u0627\u0644\u062f \u0644\u0627 \u064a\u062e\u0631\u062c \u0639\u0646 \u0627\u0644\u0645\u0648\u0636\u0629 \u0623\u0628\u062f\u0627\u064b\u061b \u0645\u0648\u0627\u062f \u0645\u062a\u0645\u064a\u0632\u0629 \u0628\u0623\u0633\u0639\u0627\u0631 \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0644\u062c\u064a\u0644 Z\u061b \u0648\u0634\u062d\u0646 \u0633\u0631\u064a\u0639 \u0648\u0645\u0648\u062b\u0648\u0642 \u062e\u0644\u0627\u0644 2\u20135 \u0623\u064a\u0627\u0645. \u0639\u0644\u0649 \u0639\u0643\u0633 \u0645\u062c\u0648\u0647\u0631\u0627\u062a \u0627\u0644\u0645\u0648\u0636\u0629 \u0627\u0644\u0633\u0631\u064a\u0639\u0629\u060c \u0642\u0637\u0639\u0646\u0627 \u0645\u0635\u0646\u0648\u0639\u0629 \u0644\u062a\u062f\u0648\u0645."
                }
            ]
        }
